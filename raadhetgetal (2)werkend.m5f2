field name=\"NAME\">lblHint</field><value name=\"VALUE\"><shadow type=\"text\" id=\"HZC1XZ`utYaD?*EE|zt(\"><field name=\"TEXT\">hoger</field></shadow></value></block></statement><next><block type=\"controls_ifelse\" id=\"QtUL3fk^!kMC?#sx:=0G\"><value name=\"IF0\"><block type=\"logic_compare\" id=\"K%[kb/A10dVqY@~miM4l\"><field name=\"OP\">GT</field><value name=\"A\"><block type=\"variables_get\" id=\"T/aB7F-}R+jKyslG7eR-\"><field name=\"VAR\" id=\"1i+Ani~b[N0qUbr4Pu;V\">gok</field></block></value><value name=\"B\"><block type=\"variables_get\" id=\"6SwO?a}9A*tHR{{9=9vB\"><field name=\"VAR\" id=\"To$$L4Q3YfCeFXS[Ili2\">geheim</field></block></value></block></value><statement name=\"DO0\"><block type=\"lvgl_label_set_text\" id=\"NuDPL*pOLQfz3}Fy~Q75\"><field name=\"NAME\">lblHint</field><value name=\"VALUE\"><shadow type=\"text\" id=\"kRKOF!g5_K$K0fhB/HJX\"><field name=\"TEXT\">lager</field></shadow></value></block></statement></block></next></block></statement><statement name=\"ELSE\"><block type=\"controls_ifelse\" id=\"WcD5{U9-s`O!oRK|pY!2\"><value name=\"IF0\"><block type=\"logic_compare\" id=\"F@pv}mSj`3)T`QjJO[mc\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"variables_get\" id=\"l}D68qPCOS]c=8dk+hgn\"><field name=\"VAR\" id=\"1i+Ani~b[N0qUbr4Pu;V\">gok</field></block></value><value name=\"B\"><block type=\"variables_get\" id=\"3n{?U=HR?2^._C+D^?[6\"><field name=\"VAR\" id=\"To$$L4Q3YfCeFXS[Ili2\">geheim</field></block></value></block></value><statement name=\"DO0\"><block type=\"lvgl_label_set_text\" id=\"OR5b,SAAy-U4g#7T5b0|\"><field name=\"NAME\">lblHint</field><value name=\"VALUE\"><shadow type=\"text\" id=\"lHLMm{Yq3i%sLHQg45rK\"><field name=\"TEXT\">geraden</field></shadow></value><next><block type=\"speaker_tone\" id=\"kKu*)Qmf!/42s/Zl;DKa\"><value name=\"FREQ\"><shadow type=\"math_number\" id=\"+%pauBta/,uY4S/}q_34\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">800</field></shadow></value><value name=\"MS\"><shadow type=\"math_number\" id=\"WsTWP0Md{G,4D[+o:k._\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">300</field></shadow></value></block></next></block></statement></block></statement></block></next></block></next></block></next></block></statement></block>","screen":[{"simulationName":"Built-in","type":"builtin","width":240,"height":240,"scale":0.9,"screenName":"","blockId":"","screenColorType":0,"rotation":0,"id":"builtin","createTime":1795607842483}],"logicWhenNum":0,"pythonCode":"import os, sys, io\nimport M5\nfrom M5 import *\nimport m5ui\nimport lvgl as lv\nfrom hardware import Rotary\n\n\n\npage0 = None\nlblGok = None\nlblHint = None\nrotary = None\n\n\nimport random\n\ngok = None\ngeheim = None\n\n\ndef setup():\n  global page0, lblGok, lblHint, rotary, gok, geheim\n\n  M5.begin()\n  Widgets.setRotation(0)\n  m5ui.init()\n  page0 = m5ui.M5Page(bg_c=0xffffff)\n  lblGok = m5ui.M5Label(\"0\", x=104, y=58, text_c=0x000000, bg_c=0xffffff, bg_opa=0, font=lv.font_montserrat_44, parent=page0)\n  lblHint = m5ui.M5Label(\"Draai en druk\", x=71, y=144, text_c=0x000000, bg_c=0xffffff, bg_opa=0, font=lv.font_montserrat_14, parent=page0)\n\n  page0.screen_load()\n  rotary = Rotary()\n  geheim = random.randint(1, 50) #het apparaat kiest random getal\n\n\ndef loop():\n  global page0, lblGok, lblHint, rotary, gok, geheim\n  M5.update()\n\n  gok = rotary.get_rotary_value()\n  lblGok.set_text(str(gok))\n\n  if BtnA.wasClicked():\n    if gok < geheim:\n      lblHint.set_text('hoger')\n    elif gok > geheim:\n      lblHint.set_text('lager')\n    elif gok == geheim:\n      lblHint.set_text('geraden!')\n      Speaker.tone(800, 300)\n\n\nif __name__ == '__main__':\n  try:\n    setup()\n    while True:\n      loop()\n  except (Exception, KeyboardInterrupt) as e:\n    try:\n      m5ui.deinit()\n      from utility import print_error_msg\n      print_error_msg(e)\n    except ImportError:\n      print(\"please update to latest firmware\")\n","customList":[]}